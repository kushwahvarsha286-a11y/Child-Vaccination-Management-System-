# VacciCare Environment Configuration
# Copy this file to .env and update the values

# Flask Configuration
SECRET_KEY=your-very-secure-secret-key-here-change-in-production
DEBUG=True
TESTING=False

# Database Configuration
# SQLite is used by default, but you can configure other databases
SQLALCHEMY_DATABASE_URI=sqlite:///vaccination.db

# Admin Account (Required for first run)
ADMIN_EMAIL=admin@vaccicare.com
ADMIN_PASSWORD=Admin@1234

# Email Configuration (Optional - for reminders)
# If not set, email reminders will be logged to console only
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# CORS Configuration (Production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com